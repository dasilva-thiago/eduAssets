# ==============================================================================
# eduAssets — Environment Variables Configuration Template
# ==============================================================================
#
# Planned Domains & Infrastructure:
# - eduassets.tech: public landing page (planned Astro project, separate)
# - app.eduassets.tech: frontend web application (planned public static hosting)
# - api.eduassets.tech: backend API (planned Oracle Free Tier with Cloudflare)
# Note: Hosting is not yet operational; these domains represent the planned target setup.
#

# --- Server & Network ---
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=

# Allowed CORS origins (comma-separated, e.g. http://localhost:5173,https://app.eduassets.tech)
# Mandatory when NODE_ENV=production or running outside local development
CORS_ORIGIN=

# --- Database (PostgreSQL / Prisma) ---
DATABASE_URL="postgresql://user:password@localhost:5432/eduassets?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/eduassets?schema=public"

# --- Authentication & Security ---
# Secret key for JWT signing (HS256). Must be at least 32 characters long.
JWT_SECRET=

# Password for initial administrator account created by seed script
SEED_ADMIN_PASSWORD=

# Optional: Password for initial test editor account created by seed script
SEED_EDITOR_PASSWORD=

# --- Logging ---
# Log level for Winston (error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=info

# --- Hardware RFID Bridge (Optional Local eduStation Integration) ---
# Set to 'true' only on installations with physical RFID hardware attached
RFID_BRIDGE_ENABLED=false
# Shared secret for local communication between Python bridge and backend (>= 32 chars)
RFID_BRIDGE_SECRET=

# --- Frontend Build & Runtime ---
# Base URL for API requests from the frontend client
VITE_API_BASE_URL=http://localhost:3000
# Whether the frontend enables the RFID listening client
VITE_RFID_BRIDGE_ENABLED=false