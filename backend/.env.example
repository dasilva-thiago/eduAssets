# ===== Database (Supabase/PostgreSQL) =====
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?pgbouncer=true
DIRECT_URL=postgresql://usuario:senha@host:5432/banco

# Authentication secret (used to sign JWT tokens)
# Run `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"` to generate a new secret.
JWT_SECRET=

# ===== Initial seed (used only to run `npx prisma db seed`) =====
SEED_ADMIN_PASSWORD=
SEED_EDITOR_PASSWORD=

# ===== CORS =====
# Production: final domains, separated by commas, without trailing slash
CORS_ORIGIN=https://eduassets.tech,https://www.eduassets.tech

# ===== Ambient =====
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Define "1" if there is exactly one reverse proxy in front (nginx/Cloudflare Tunnel).
# In production, if omitted, the server assumes 1 automatically (see server.ts).
TRUST_PROXY=1

# RFID (optional hardware — leave EVERYTHING commented/absent in the public demo)
# RFID_BRIDGE_ENABLED=true
# RFID_BRIDGE_SECRET=

# ===== Logs =====
LOG_LEVEL=info