[Unit]
Description=eduAssets RFID Admin Login Bridge
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/eduassets-rfid
EnvironmentFile=/etc/eduassets/rfid_bridge.env
ExecStart=/home/dasilva-thiago/Projetos/eduAssets/rpi/venv/bin/python3 /opt/eduassets-rfid/rfid_admin_bridge.py
Restart=on-failure
RestartSec=3
User=pi
ExecStartPre=/bin/sh -c '[ "$(stat -c %a /etc/eduassets/rfid_bridge.env)" = 600 ]'
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
